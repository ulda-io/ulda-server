# Copy this file to .env before running Docker Compose.
# Never commit the resulting .env file.
POSTGRES_DB=ulda
POSTGRES_USER=ulda
# Bootstrap administrator is never used by server/migrate.
# Generate password files with node scripts/create-local-secrets.mjs.
ULDA_SECRETS_DIR=./secrets
ULDA_SERVER_IMAGE=ulda/server:local
ULDA_POSTGRES_IMAGE=ulda/postgres:local
# Host publication only; the server still listens on 0.0.0.0 inside Docker.
# Expose beyond loopback only with an appropriate TLS proxy/firewall policy.
ULDA_PUBLISH_ADDRESS=127.0.0.1
ULDA_SERVER_PORT=3000
CORS_ORIGINS=http://localhost:3000

NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info

# Outside Compose, either set DATABASE_URL or standard PGHOST/PGPORT/PGUSER/
# PGPASSWORD/PGDATABASE variables. DATABASE_URL is intentionally blank here.
# DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# PostgreSQL-side limits; do not replace with client Promise timeouts for writes.
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# HTTP readiness only: shared probe, short cache, bounded response waiters.
READINESS_TIMEOUT_MS=2000
READINESS_CACHE_MS=1000
READINESS_MAX_WAITERS=32

# Optional trusted ESM module. When set, it replaces the built-in PostgreSQL
# adapter. The operator then owns that backend and its migrations.
# STORAGE_ADAPTER_MODULE=/app/adapters/my-storage.mjs

ULDA_PROTOCOL_VERSION=1.0
ULDA_CORE_VERSION=1.0.1
# Recommended client-generation profile. Create does not inspect/enforce it.
# ULDA_ORIGIN_SIZE is also required by the Compact V1 verifier.
ULDA_PACK=compactV1
ULDA_N=5
ULDA_MODE=S
ULDA_HASH=SHA-256
ULDA_ORIGIN_SIZE=256
ULDA_AGE_BYTES=4

MAX_WITNESS_BYTES=16384
# Inbound Engine.IO message/frame limit for one serialized command packet.
MAX_SOCKET_MESSAGE_BYTES=67108864
MAX_SUBSCRIPTIONS_PER_SOCKET=32768
# Maximum running + queued reservations for one resource.
MAX_QUEUED_PER_RESOURCE=100
# Total reservation capacity. A batch uses one slot per unique resource id.
MAX_QUEUED_TOTAL=32768
# SDK outbound backlog per connection; slow receivers disconnect without undoing commit.
MAX_BUFFERED_SOCKET_BYTES=16777216
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# SDK admission. Budgets are accounting units, not a promised V8/OS RSS ceiling.
# Engine.IO live connections + pending handshakes (one physical connection per SDK).
MAX_CONNECTIONS=1000
# Total resource-socket edges, including pending subscription reservations.
MAX_SUBSCRIPTIONS_TOTAL=100000
# Partial/decoded/queued/running input: 1024 per packet + header*4 + binary/frame
# bytes + 3*validated logical binary bytes reserved before defensive copies.
MAX_INFLIGHT_BYTES=67108864
# Worst-case encrypted row bytes reserved before storage reads/validation.
MAX_ACTIVE_READ_BYTES=268435456
# Extended transfers retain ciphertext only; one staged write per connection.
MAX_RESOURCE_BYTES=67108864
MAX_TRANSFER_BYTES=134217728
MAX_STAGED_BYTES=268435456
TRANSFER_TIMEOUT_MS=60000
# All SDK outgoing connections combined; also a fixed 65536 packet cap.
MAX_BUFFERED_TOTAL_BYTES=67108864
MAX_PENDING_COMMANDS_PER_SOCKET=64
# Token bucket per decoder; includes control packets. No automatic request retry.
MAX_COMMANDS_PER_SECOND=1000
COMMAND_BURST=2000
# Absolute deadline from binary header, not extended by trickle attachments.
BINARY_PACKET_TIMEOUT_MS=30000
