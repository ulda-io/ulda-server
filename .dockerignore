# Send only required build inputs to the builder. Local configuration, Git,
# logs, reports, tests, demos and unrelated files stay outside the context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!LICENSE.md
!THIRD_PARTY_NOTICES.md
!tsconfig.json
!tsconfig.build.json
!src/
src/**
!src/**/*.ts
!migrations/
!migrations/postgres/
migrations/**
!migrations/postgres/*.sql
